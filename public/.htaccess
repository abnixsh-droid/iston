# Hostinger (Apache/LiteSpeed) — SPA routing
Options -Indexes

RewriteEngine On
RewriteBase /

# Force HTTPS
# Enable SSL in Hostinger hPanel first
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve existing files OR directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite API paths
# PHP APIs such as /api/upload.php and /api/delete.php
# are handled directly by Hostinger.
RewriteRule ^api/ - [L]

# SPA fallback
RewriteRule . /index.html [L]

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Force PDF downloads
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
